[Unit]
Description=Import TRANS speech and run local Traffic Analysis classification

[Service]
Type=oneshot
WorkingDirectory=%h/github/traffic_analysis
ExecStart=/usr/bin/python3 %h/github/traffic_analysis/tools/run_corpus_cycle.py
UMask=0077
TimeoutStartSec=infinity
Nice=10
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/traffic-analysis %h/Research.Databases/traffic_analysis
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
Environment=PYTHONDONTWRITEBYTECODE=1
